# Neon — in https://console.neon.tech open your project → Connection details → copy the URI.
# Prefer the pooled / serverless string for Next.js runtime on Netlify and `@neondatabase/serverless`
# (often includes `-pooler` in the host).
DATABASE_URL=

# Prefer the direct (non-pooled) string for migrations / Drizzle Kit.
# Neon often labels this as "Direct connection" (host typically does NOT include `-pooler`).
DATABASE_URL_DIRECT=

# Better Auth — use `pnpm exec auth secret` or `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Better Auth Dash / infra — API key from https://dash.better-auth.com (after onboarding)
BETTER_AUTH_API_KEY=

# Server + cookie base URL (no trailing slash). Must match the URL you open in the browser
# when using ngrok, Netlify, or previews (both this and NEXT_PUBLIC_APP_URL should use that host).
BETTER_AUTH_URL=http://localhost:3000

# In the browser bundle; should match BETTER_AUTH_URL for the same deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GA4 / Google tag (match WordPress Site Kit — do not invent alternate IDs).
# NEXT_PUBLIC_* is baked at Docker build from GitHub secrets STAGING_BUILD_ENV
# or PROD_BUILD_ENV (see .github/workflows/deploy.yml). Runtime env on the
# droplet does not change those values.
# NEXT_PUBLIC_GOOGLE_TAG_ID=GT-MK4HNLVK
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Z2581VYBE3
# NEXT_PUBLIC_GADS_CONVERSION_ID=AW-17767633830
#
# Checkout Ads conversion label — PROD_BUILD_ENV only. Leave unset in
# STAGING_BUILD_ENV so staging images never contain the send_to.
# NEXT_PUBLIC_GADS_CHECKOUT_CONVERSION_SEND_TO=AW-17767633830/THfyCPCPh-wcEKanophC
#
# Marketing tags (Google tag, Ads, Meta Pixel) also load only when the
# request Host is visatop.com or www.visatop.com (defense in depth). Staging
# host app-staging.visatop.com stays off even if a prod ID were baked.
# Optional runtime kill switch (docker run -e, no rebuild): ENABLE_MARKETING_TAGS=false
# Do not set NEXT_PUBLIC_ENABLE_MARKETING_TAGS.
# GTM-T6D7X53B / Clarity are not loaded in this app (WordPress-only until Ads conversions match).

# Optional: comma-separated extra allowed origins (e.g. alternate preview URLs).
# BETTER_AUTH_TRUSTED_ORIGINS=https://branch--site.netlify.app,https://xxxx.ngrok-free.app

# Optional (dev only): extra hostnames for Next.js allowedDevOrigins if the tunnel host
# is not already derivable from BETTER_AUTH_URL / NEXT_PUBLIC_APP_URL (e.g. a second ngrok URL).
# ALLOWED_DEV_ORIGINS=other-subdomain.ngrok-free.app

# -----------------------------
# Social login (clients only)
# Redirect URIs (local):
# - http://localhost:3000/api/auth/callback/google
# - http://localhost:3000/api/auth/callback/facebook
# Redirect URIs (prod):
# - https://your-domain.com/api/auth/callback/google
# - https://your-domain.com/api/auth/callback/facebook
# -----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# (Deprecated) PRICING_AFFILIATE_SITE_ID is no longer used. Customer prices are loaded from catalog_customer_price.

# Optional: AED per 1 USD for the apply/start currency tabs when catalog reference prices are in the other currency.
# Display-only; checkout still locks a server-side price quote.
# NEXT_PUBLIC_DISPLAY_FX_AED_PER_USD=3.6725

# Vitest integration (RLS): set RUN_DB_TESTS=1 and use a disposable Postgres with migrations applied.
# RUN_DB_TESTS=

# Guest link after payment — HMAC cookie `vt_link_intent`. Required for prepare + link; without it those routes return 503.
# Must be ≥ 32 bytes as UTF-8 (character count can be lower for multi-byte chars). Do not reuse Paddle secrets.
# Generate: openssl rand -base64 32
GUEST_LINK_INTENT_SECRET=

# Guest link feature kill switch: only the string `false` disables prepare + link (503).
# Unset or any other value = enabled (including staging). Do not assume “unset = off”.
# GUEST_LINK_AFTER_AUTH_ENABLED=true

# Portal workspace highlight for `?applicationId=` deep links (`false` → slip to /apply/...?linked=1).
# WORKSPACE_APPLICATION_HIGHLIGHT_ENABLED=true

# Optional: run tests/integration/guest-link-audit-rls.test.ts against a real DATABASE_URL.
# GUEST_LINK_RLS_INTEGRATION=

# Internal cron: header x-internal-secret must match INTERNAL_CRON_SECRET
# POST /api/internal/cleanup-drafts — draft TTL cleanup
# POST /api/internal/reconcile-ziina-payments — Ziina status reconcile at +5m, +10m, +15m after checkout
# POST /api/internal/reconcile-fincra-payments — Fincra verify at +5m, +15m, +60m, +24h (success webhooks only)
# INTERNAL_CRON_SECRET=

# -----------------------------
# Passport OCR (Gemini)
# -----------------------------
# API key from https://aistudio.google.com/ — required at runtime for POST /extract.
# CI must run without this (tests mock the SDK).
# GEMINI_API_KEY=
# Override the default OCR model if needed.
# GEMINI_MODEL_ID=gemini-2.5-flash
# Optional: bump to invalidate cached prompts / extraction rows.
# GEMINI_PROMPT_VERSION=1


# Payments: `paddle` (default) or `ziina` — single active provider per deployment.
# PAYMENT_PROVIDER=paddle

# Local dev safety: payments require an https origin (tunnel) so webhooks can reach your machine.
# Set NEXT_PUBLIC_APP_URL / BETTER_AUTH_URL to your ngrok https URL, or (not recommended) bypass:
# PAYMENTS_ALLOW_INSECURE_LOCALHOST=true

# Paddle API
PADDLE_API_KEY=pdl_sdbx_apikey
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

# Paddle Frontend
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox

# Ziina (when PAYMENT_PROVIDER=ziina) — server-only; webhook at POST /api/webhooks/ziina
# ZIINA_API_BASE_URL=https://api-v2.ziina.com/api
# ZIINA_ACCESS_TOKEN=
# ZIINA_WEBHOOK_SECRET=
# ZIINA_TEST_MODE=true
# ZIINA_ENFORCE_WEBHOOK_IP_ALLOWLIST=false
# Dev only — never in production: ZIINA_WEBHOOK_ALLOW_UNSIGNED=true

# Fincra (optional second provider). Off by default. When enabled, Nigerian nationality
# applications with a stored NGN catalog price (kobo) are offered Pay in Naira; everyone
# else keeps PAYMENT_PROVIDER. No FX: missing NGN rows fall back to the default provider.
# Fincra only accepts API calls from whitelisted IPs (portal 138.68.184.84). Do not call
# sandbox from local/cloud VMs — mock in tests; live sandbox testing is on staging.
# Webhook URL to register in Fincra: https://<host>/api/webhooks/fincra
# FINCRA_ENABLED=false
# FINCRA_API_BASE_URL=https://sandboxapi.fincra.com
# Live: https://api.fincra.com
# FINCRA_SECRET_KEY=
# FINCRA_PUBLIC_KEY=
# FINCRA_BUSINESS_ID=
# FINCRA_WEBHOOK_SECRET=
# Fee bearer: business (VisaTop / merchant, default) or customer
# FINCRA_FEE_BEARER=business

# -----------------------------
# Transactional email (Mailgun EU)
# -----------------------------
# Private API key from Mailgun (Sending → Domain → SMTP/API credentials).
# MAILGUN_API_KEY=
# Verified sending domain (e.g. mail.visatop.com).
# MAILGUN_DOMAIN=mail.visatop.com
# Default: https://api.eu.mailgun.net — override only if Mailgun gives a different EU host.
# MAILGUN_API_BASE_URL=https://api.eu.mailgun.net
# From header (RFC5322). Example uses your verified domain.
# MAILGUN_FROM=Visatop <info@visatop.com>
# Reply-To for applicant document-upload help mail uses the existing ops inbox
# (lib/email/admin-notification-constants.ts). Optional override:
# MAILGUN_REPLY_TO=
# Appended to every plain-text transactional body (multi-line OK).
# EMAIL_TRANSACTIONAL_FOOTER=—\nVisatop\n...

# -----------------------------
# Observability (self-hosted GlitchTip + Pino JSON -> Alloy -> Loki + droplet stack)
# App SDK / readiness: docs/observability/sentry.md
# Structured logs: docs/observability/logging.md
# Infra (Grafana/Alloy/Loki/Tempo/Kuma): docs/observability/infra.md
# Do not start deploy/observability/ from GitHub Actions. Farouk runs up.sh.
# -----------------------------
# Sentry-compatible SDK. Leave both DSNs empty for a no-op (local/CI).
# Server events use SENTRY_DSN (runtime on the droplet). Browser events need
# NEXT_PUBLIC_SENTRY_DSN in STAGING_BUILD_ENV / PROD_BUILD_ENV (baked at image build).
# Point the DSN host at GlitchTip — never sentry.io.
# After `./scripts/up.sh errors`, the in-Docker host is visatop-glitchtip:8000:
# SENTRY_DSN=http://<public_key>@visatop-glitchtip:8000/1
# Browser DSN still needs a host the browser can reach (SSH tunnel or obs Caddy);
# do not expose GlitchTip on 0.0.0.0.
# NEXT_PUBLIC_SENTRY_DSN=https://<public_key>@<glitchtip-host>/<project_id>
#
# Distinguish staging vs production. Docker deploy.yml sets this from the
# workflow environment (staging|production). Do not use NODE_ENV for this.
# Shared by GlitchTip tags and Pino `env` / `release` fields.
# APP_ENV=development
# NEXT_PUBLIC_APP_ENV=development
#
# Release is the git sha. deploy.yml passes GIT_SHA as a Docker build-arg;
# blue-green-deploy.sh also injects GIT_SHA at docker run from the image tag.
# GIT_SHA=
# RELEASE_SHA=
# SENTRY_RELEASE=
# NEXT_PUBLIC_GIT_SHA=
# NEXT_PUBLIC_SENTRY_RELEASE=
#
# Modest Web Vitals / trace sampling (0–1). Default 0.1 when unset.
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
#
# Optional client tag only. Server already reads PAYMENT_PROVIDER.
# NEXT_PUBLIC_PAYMENT_PROVIDER=paddle
#
# Optional source-map upload to *this* GlitchTip instance. Both must be set.
# Builds never talk to sentry.io and do not require a token when these are empty.
# SENTRY_URL=https://glitchtip.example
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=visatop
# SENTRY_PROJECT=visatop-next
#
# Pino JSON on stdout is scraped by Grafana Alloy into self-hosted Loki.
# LOG_LEVEL=info
# OTEL_SERVICE_NAME / OTEL_EXPORTER_OTLP_* are listed once in the tracing block below.

# -----------------------------
# Synthetics (optional Playwright cron / container)
# -----------------------------
# PLAYWRIGHT_BASE_URL=https://app-staging.visatop.com
# SYNTHETIC_NATIONALITY_CODE=IN
# SYNTHETIC_NATIONALITY_NAME=India
# SYNTHETIC_EMAIL=synthetic@example.com
# SYNTHETIC_PASSPORT_PATH=/path/to/passport.jpg

# -----------------------------
# OpenTelemetry tracing (optional)
# -----------------------------
# Unset = no-op (SDK does not start). Staging/production on the droplet should
# point at the self-hosted Grafana Alloy OTLP HTTP receiver on visatop_edge.
# Compose service DNS is `alloy` (container_name visatop-alloy also resolves):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
# Optional full traces URL (wins over the base endpoint):
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://alloy:4318/v1/traces
# APP_ENV / GIT_SHA are shared with GlitchTip above (never NODE_ENV).
# Parent-based ratio sampler; default 1.0 (low traffic). Tail-sample at Alloy.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_RATIO=1
# Shared with Pino `service` (see logging.md).
# OTEL_SERVICE_NAME=visatop-next-js
# OTEL_DIAGNOSTIC_LOGS=1
# See docs/observability/tracing.md

WP_ORIGIN=https://<your-wp-host>
WP_PUBLIC_ASSET_HOSTS=<your-wp-host>,<any-cdn-host>
# Hide native Polylang/theme language controls in the WP header/footer iframes.
# The Next lookalike switcher is still injected so locale stays on `vt_locale`.
DISABLE_WP_LANG_SWITCHER=true