# Copy to .env on the droplet (never commit the real file).
#   cp deploy/observability/env.example /root/visatop/deploy/observability/.env
# Compose reads this file from the same directory as docker-compose.yml.

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-long-random
# Used by provisioned email contact point. Mailgun SMTP is already how VisaTop sends mail.
GRAFANA_ALERT_EMAIL=ops@example.com
# WhatsApp-compatible webhook (CallMeBot, n8n, WhatsApp Cloud, etc.). Leave as the
# placeholder until Farouk pastes a real URL — alerts still go to email.
GRAFANA_ALERT_WEBHOOK_URL=http://127.0.0.1:9/configure-me
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.eu.mailgun.org:587
GF_SMTP_USER=changeme
GF_SMTP_PASSWORD=changeme
GF_SMTP_FROM_ADDRESS=alerts@visatop.com
GF_SMTP_FROM_NAME=VisaTop alerts
GF_SMTP_STARTTLS_POLICY=MandatoryStartTLS

# --- Observability Caddy (optional extra lock in front of UIs) ---
OBS_BASIC_AUTH_USER=farouk
# Plaintext. up.sh hashes this for Caddy — do not paste a bcrypt string here
# (the $ signs in bcrypt break Docker Compose interpolation).
OBS_BASIC_AUTH_PASSWORD=change-me-caddy-basic-auth

# --- GlitchTip (Sentry-compatible) ---
GLITCHTIP_SECRET_KEY=change-me-django-secret-at-least-50-chars
GLITCHTIP_POSTGRES_PASSWORD=change-me-glitchtip-pg
# Browser / SSH-tunnel URL. Keep http://127.0.0.1:3040 until a protected subdomain exists.
GLITCHTIP_DOMAIN=http://127.0.0.1:3040
GLITCHTIP_DEFAULT_FROM_EMAIL=alerts@visatop.com
# Optional Mailgun-style SMTP for GlitchTip notification mail.
GLITCHTIP_EMAIL_URL=consolemail://
# 15 days of events. Raise to 30 only if disk headroom is confirmed.
GLITCHTIP_MAX_EVENT_LIFE_DAYS=15
# Org/project slugs used by deploy-marker script (create them in the GlitchTip UI first).
GLITCHTIP_ORG_SLUG=visatop
GLITCHTIP_PROJECT_SLUG=visatop-next
# Auth token from GlitchTip UI (User → Auth tokens). Leave empty to skip release markers.
GLITCHTIP_AUTH_TOKEN=

# --- Uptime Kuma ---
# First visit http://127.0.0.1:3050 over an SSH tunnel and create the admin user.

# --- App container env (add to /root/visatop/.env and .env.staging, then redeploy) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://visatop-alloy:4318/v1/traces
# OTEL_SERVICE_NAME=visatop-next-js
# SENTRY_DSN=http://<public-key>@visatop-glitchtip:8000/1
# SENTRY_ENVIRONMENT=production
